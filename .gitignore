# .gitignore ----------------------------------------------------------------- #
# Author: Louis Trocellier
# Description: Git ignore rules for session, data, secrets, and rendered notebooks.

# RStudio / R Session files
.Rproj.user
.Rhistory
.RData
.RuserData
*.Rproj
.DS_Store
Thumbs.db
rsconnect/

# Environment Variables & Credentials
.env
.Renviron

# renv: Version the lockfile and activation, not the local cache
renv/library/
renv/python/
renv/sandbox/
renv/staging/

# Quarto & RMarkdown Rendered Outputs & Cache
*.html
*.pdf
*.docx
*.md
*_files/
*_cache/
.quarto/

# Data, Logs & Generated Outputs
logs/*
!logs/.gitkeep

data/*
!data/.gitkeep

outputs/*
!outputs/.gitkeep

# Docker temporary artifacts
*.tar