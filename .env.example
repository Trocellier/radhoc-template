# .env.example --------------------------------------------------------------- #
# Author: Louis Trocellier
# Description: Environment variables template for local setup.
# Instructions: Copy this file to '.env' and fill in your credentials.

# Application Environment (default / production)
APP_ENV=default

# Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_database
DB_USER=your_username
DB_PASSWORD=your_password
